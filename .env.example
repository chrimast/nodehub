# Documentation only; generate .env with scripts/init_env.py.
ADMIN_TOKEN=generate-at-least-32-random-bytes
ENGINE_SECRET=generate-and-preserve-a-separate-random-engine-secret
HOST_ID=
AGENT_TOKEN=

# Persistent AES-256 key, 64 hex chars; never lose this or change it without re-encryption
MASTER_KEY=

# SQLite file used by the nodehub branch. Postgres is not supported on this fork.
DATABASE_URL=sqlite:///state/nodehub.db

# Native control only: absolute trusted package directory built by build-agent-releases.py
# AGENT_RELEASE_DIR=/opt/harbor/agent-releases-v05
